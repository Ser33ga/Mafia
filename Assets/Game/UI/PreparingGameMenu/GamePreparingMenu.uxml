<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:ScrollView name="InteractiveElements"/>
    <ui:VisualElement name="RolesOrderEL" style="flex-grow: 1;">
        <ui:ListView name="RolesOrderList"/>
        <ui:Button text="Save" name="SaveRolesOrderBTN"/>
        <ui:Button text="Reset" name="ResetRolesOrderBTN"/>
    </ui:VisualElement>
    <ui:VisualElement name="RolesEL" style="flex-grow: 1;">
        <ui:ListView name="RolesList"/>
        <ui:Button text="Save" name="SaveRolesInGameBTN"/>
        <ui:Button text="Reset" name="ResetRolesInGameBTN"/>
    </ui:VisualElement>
    <ui:VisualElement name="PlayersEL" style="flex-grow: 1;">
        <ui:ListView name="PlayersList"/>
        <ui:Button text="Save" name="SavePlayersBTN"/>
        <ui:Button text="Reset" name="ResetPlayersBTN"/>
        <ui:Button text="AddEmpty" name="AddEmptyPlayerBTN"/>
    </ui:VisualElement>
    <ui:Button text="StartGame" name="StartGameBTN"/>
    <ui:Button text="Menu" name="MenuBTN"/>
</ui:UXML>
